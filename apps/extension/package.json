{
  "name": "gmv-extension",
  "private": true,
  "version": "12.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test:e2e": "node scripts/build.mjs && vitest run -c e2e/vitest.config.ts",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted",
