    "@gmvjs/xray-v1": "^0.1.1"
  },
  "devDependencies": {
    "@gmvjs/rage": "^0.1.1",
    "assimpjs": "0.0.10",
    "playwright-core": "^1.64.1",
    "vitest": "^3.2.4",
    "web-ext": "^8.10.0"
  }
