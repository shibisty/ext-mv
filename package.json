{
  "name": "ext-mv",
  "private": true,
  "version": "12.0.0",
  "description": "Game Model Viewer: браузерное расширение для Chrome/Firefox на библиотеке gmv (пакеты @gmvjs/* из npm)",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run build -w gmv-extension",
    "build:ext": "npm run build -w gmv-extension",
    "dev": "npm run dev -w gmv-extension",
    "typecheck": "tsc -p apps/extension/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w gmv-extension",
    "test:e2e:install": "npm run e2e:install -w gmv-extension",
    "lint:firefox": "npm run lint:firefox -w gmv-extension",
    "check": "npm run typecheck && npm test && npm run build && npm run lint:firefox",
    "dev:firefox": "npm run dev -w gmv-extension -- firefox"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4",
    "vite-node": "^3.2.4"
  }
}
