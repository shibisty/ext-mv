{
  "manifest_version": 3,
  "name": "Game Model Viewer",
  "version": "11.0.0",
  "description": "WebGL-просмотрщик моделей игр: X-Ray, Bethesda, GTA, id Tech, Valve, Unreal, CoD, NFS, CryEngine и др., форматы assimp.",
  "action": {
    "default_title": "Открыть OGF Viewer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}